{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accepted_log_receipt.schema.json",
  "title": "DATA PING Accepted Log Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "accepted_log_id",
    "data_ping_version",
    "source_timestamp",
    "accepted_at",
    "source_mode",
    "framework_acceptance_status",
    "accepted_payload_path",
    "accepted_payload_commit_sha",
    "accepted_payload_hash_sha256",
    "data_quality",
    "field_coverage",
    "missing_fields",
    "readback_status",
    "hash_status",
    "forecast_row_permission",
    "source_payload"
  ],
  "properties": {
    "contract_version": {"const": "0.1"},
    "accepted_log_id": {"type": "string", "minLength": 8},
    "data_ping_version": {"type": "integer", "minimum": 1},
    "source_timestamp": {"type": "string", "format": "date-time"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "source_mode": {"const": "ACCEPTED_LOG_DERIVED"},
    "framework_acceptance_status": {"type": "string", "minLength": 1},
    "accepted_payload_path": {"type": "string", "minLength": 1},
    "accepted_payload_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "accepted_payload_hash_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_quality": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "MIXED", "UNKNOWN"]},
    "field_coverage": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missing_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "readback_status": {"enum": ["PASS", "FAIL"]},
    "hash_status": {"enum": ["PASS", "FAIL"]},
    "forecast_row_permission": {"enum": ["ELIGIBLE_BY_FIELD", "MATURITY_ONLY", "BLOCKED"]},
    "source_payload": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
