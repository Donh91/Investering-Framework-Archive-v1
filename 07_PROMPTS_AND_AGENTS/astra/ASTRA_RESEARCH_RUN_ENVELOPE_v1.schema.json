{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ASTRA_RESEARCH_RUN_ENVELOPE_v1",
  "title": "Astra Research Run Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "run_id",
    "task_family",
    "frozen_question",
    "decision_at",
    "required_capabilities",
    "execution_mode",
    "budget",
    "authority",
    "assignments",
    "evidence",
    "disagreement",
    "utility_policy"
  ],
  "properties": {
    "contract": {"const": "ASTRA_RESEARCH_RUN_ENVELOPE_v1"},
    "run_id": {"type": "string", "minLength": 8},
    "task_family": {"type": "string", "minLength": 1},
    "frozen_question": {"type": "string", "minLength": 3},
    "decision_at": {"type": "string", "format": "date-time"},
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "execution_mode": {
      "enum": ["STANDARD", "TARGETED_VERIFIER", "ADVERSARIAL", "REPLICATION", "BLIND_OPPOSITION"]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_agents", "max_parallel_agents", "max_total_tokens", "max_wallclock_seconds", "effort_ceiling", "escalation_reserve_pct"],
      "properties": {
        "max_agents": {"type": "integer", "minimum": 1, "maximum": 12},
        "max_parallel_agents": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_total_tokens": {"type": "integer", "minimum": 1000},
        "max_wallclock_seconds": {"type": "integer", "minimum": 1},
        "effort_ceiling": {"enum": ["LOW", "MEDIUM", "HIGH", "XHIGH", "MAX"]},
        "escalation_reserve_pct": {"type": "number", "minimum": 0, "maximum": 50}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_only", "market_state_change", "portfolio_action", "trade_action", "canonical_self_promotion", "automatic_merge"],
      "properties": {
        "research_only": {"const": true},
        "market_state_change": {"const": false},
        "portfolio_action": {"const": false},
        "trade_action": {"const": false},
        "canonical_self_promotion": {"const": false},
        "automatic_merge": {"const": false}
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assignment"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "disagreement": {"$ref": "#/$defs/disagreement"},
    "utility_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "auto_pruning_enabled", "auto_routing_promotion"],
      "properties": {
        "mode": {"const": "SHADOW_LOG_ONLY"},
        "auto_pruning_enabled": {"const": false},
        "auto_routing_promotion": {"const": false}
      }
    },
    "utility_observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/utility"}
    }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "capability", "question", "question_hash", "responsibility_scope", "mode", "token_budget", "effort", "committed_before_reveal"],
      "properties": {
        "assignment_id": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 3},
        "question_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "responsibility_scope": {"type": "string", "minLength": 1},
        "mode": {"enum": ["STANDARD", "TARGETED_VERIFIER", "ADVERSARIAL", "REPLICATION"]},
        "blind_group": {"type": ["string", "null"]},
        "token_budget": {"type": "integer", "minimum": 1},
        "effort": {"enum": ["LOW", "MEDIUM", "HIGH", "XHIGH", "MAX"]},
        "committed_before_reveal": {"type": "boolean"},
        "output_hash": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_ref", "effective_at", "observable_at", "retrieved_at", "used_for_decision", "leakage_status"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "content_hash": {"type": ["string", "null"]},
        "effective_at": {"type": "string", "format": "date-time"},
        "observable_at": {"type": "string", "format": "date-time"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "used_for_decision": {"type": "boolean"},
        "leakage_status": {"enum": ["POINT_IN_TIME_VALID", "QUARANTINED_LOOKAHEAD", "UNVERIFIED", "NOT_APPLICABLE"]},
        "visibility": {"enum": ["PUBLIC_CONTROL_PLANE", "RESTRICTED_BINDING_ONLY", "LOCAL_EPHEMERAL"]}
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fact_disagreement_count", "source_collision_count", "coverage_gap_count", "unresolved_load_bearing_claims", "resolution_status"],
      "properties": {
        "status": {"const": "SHADOW_ONLY"},
        "fact_disagreement_count": {"type": "integer", "minimum": 0},
        "source_collision_count": {"type": "integer", "minimum": 0},
        "interpretation_split": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "forecast_probability_dispersion": {"type": ["number", "null"], "minimum": 0},
        "confidence_dispersion": {"type": ["number", "null"], "minimum": 0},
        "coverage_gap_count": {"type": "integer", "minimum": 0},
        "unresolved_load_bearing_claims": {"type": "integer", "minimum": 0},
        "resolution_status": {"enum": ["AGREED", "CONTESTED", "UNVERIFIED", "DATA_BLOCKED", "NOT_APPLICABLE"]}
      }
    },
    "utility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "mode", "tokens_used", "latency_ms", "unique_verified_evidence", "material_falsifier_or_contradiction", "decisive_gap_resolution", "material_synthesis_delta", "failure_or_no_value"],
      "properties": {
        "assignment_id": {"type": "string"},
        "mode": {"const": "SHADOW_LOG_ONLY"},
        "tokens_used": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0},
        "unique_verified_evidence": {"type": "integer", "minimum": 0},
        "material_falsifier_or_contradiction": {"type": "integer", "minimum": 0},
        "decisive_gap_resolution": {"type": "boolean"},
        "material_synthesis_delta": {"type": "boolean"},
        "quality_or_calibration_delta": {"type": ["number", "null"]},
        "failure_or_no_value": {"type": "boolean"}
      }
    }
  }
}
