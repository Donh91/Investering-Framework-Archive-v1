{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EXTERNAL_ALPHA_CANDIDATE_INTAKE_V1",
  "title": "External Alpha Candidate Intake",
  "type": "object",
  "required": [
    "name",
    "case_type",
    "source_urls",
    "discovery_reason",
    "evidence_claims",
    "hard_falsifiers"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "case_type": {
      "type": "string",
      "enum": [
        "CRYPTO_AI_TRADER",
        "PREDICTION_MARKET_AI",
        "WALLET_INTELLIGENCE",
        "WALLET_ROTATION",
        "EXECUTION_SYSTEM",
        "STRATEGY_REPOSITORY",
        "SIGNAL_PROVIDER",
        "OTHER"
      ]
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "discovery_reason": {"type": "string", "minLength": 1},
    "evidence_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence_class"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence_class": {
            "type": "string",
            "enum": ["PRIMARY", "OPEN_SOURCE_IMPLEMENTATION", "SECONDARY", "SOCIAL_CLAIM", "UNKNOWN"]
          },
          "source": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "identity_hint": {"type": ["string", "null"]},
    "sample_size_claim": {"type": ["integer", "null"], "minimum": 0},
    "track_record_period": {"type": ["string", "null"]},
    "losers_visible_claim": {"type": ["boolean", "null"]},
    "point_in_time_evidence_claim": {"type": ["boolean", "null"]},
    "opportunity_set_hint": {"type": ["string", "null"]},
    "execution_evidence_hint": {"type": ["string", "null"]},
    "possible_transfer_primitives": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "hard_falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
