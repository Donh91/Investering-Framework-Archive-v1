{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Distribution Evidence Row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "test_id",
    "source_packet_id",
    "source_hash",
    "observed_at_utc",
    "asset",
    "horizon",
    "frozen_state",
    "benchmark_state",
    "observation_unit",
    "independent_event_id",
    "overlap_group_id",
    "right_censored",
    "actual_decision_divergence",
    "source_quality",
    "source_anomaly_flags",
    "unit_matched_control",
    "regime_label",
    "row_status"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "test_id": {
      "enum": [
        "FRLP_V0_1",
        "GATE_BTC_PARTIAL_FT_1",
        "PULLBACK_EDGE_20260708_01_OUTCOMES",
        "FNP_CUMULATIVE"
      ]
    },
    "source_packet_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "minLength": 1},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "asset": {"type": "string", "minLength": 1},
    "horizon": {"type": "string", "minLength": 1},
    "frozen_state": {"type": "string"},
    "benchmark_state": {"type": "string"},
    "observation_unit": {"enum": ["DAY", "INDEPENDENT_EVENT", "WEEK", "DECISION_DIVERGENCE"]},
    "independent_event_id": {"type": "string"},
    "overlap_group_id": {"type": "string"},
    "right_censored": {"type": "boolean"},
    "actual_decision_divergence": {"type": "boolean"},
    "source_quality": {"enum": ["FULL", "DEGRADED", "DATA_MISSING", "SOURCE_CONFLICT", "CORRECTION", "PRINT_GAP"]},
    "source_anomaly_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "matured_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "end_return_pct": {"type": ["number", "null"]},
    "mfe_pct": {"type": ["number", "null"]},
    "mae_pct": {"type": ["number", "null"]},
    "max_drawdown_pct": {"type": ["number", "null"]},
    "worst_path_pct": {"type": ["number", "null"]},
    "time_to_mfe_hours": {"type": ["number", "null"], "minimum": 0},
    "time_to_mae_hours": {"type": ["number", "null"], "minimum": 0},
    "drawdown_avoided_pct": {"type": ["number", "null"]},
    "missed_upside_pct": {"type": ["number", "null"]},
    "opportunity_cost_pct": {"type": ["number", "null"]},
    "false_permission_cost_pct": {"type": ["number", "null"]},
    "outcome_class": {"type": ["string", "null"]},
    "outcome_source": {"type": ["string", "null"]},
    "outcome_hash": {"type": ["string", "null"]},
    "unit_matched_control": {"type": "boolean"},
    "regime_label": {"type": "string"},
    "row_status": {"enum": ["FROZEN_SOURCE", "MATURED_OUTCOME", "RIGHT_CENSORED", "CORRECTION", "HISTORICAL_EVENT_STUDY_ONLY"]},
    "revision_of": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
