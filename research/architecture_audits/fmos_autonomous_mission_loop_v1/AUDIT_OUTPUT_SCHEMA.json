    "shadow_qualification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_design",
        "metrics",
        "graduation_A1",
        "graduation_A2",
        "failure_injection_cases"
      ],
      "properties": {
        "sample_design": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graduation_A1": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graduation_A2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_injection_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "kill_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_task_packets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "dependencies",
          "allowed_paths",
          "forbidden_changes",
          "acceptance_tests",
          "stop_conditions"
