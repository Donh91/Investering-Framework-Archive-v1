          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reproduction": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string"
          },
          "minimum_fix": {
            "type": "string"
          }
        }
      }
    },
    "verified_defenses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternative_designs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "design",
          "benefit",
          "risk",
          "complexity",
          "decision"
        ],
        "properties": {
          "design": {
            "type": "string"
          },
          "benefit": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "complexity": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "PREFER",
              "VIABLE",
              "DEFER",
              "REJECT"
            ]
          }
        }
      }
    },
    "recommended_minimal_architecture": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_and_state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_model",
        "states",
        "legal_transitions",
        "forbidden_transitions"
      ],
      "properties": {
        "authority_model": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legal_transitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_transitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "implementation_change_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "change",
          "why_existing_owner",
          "tests",
          "authority_impact",
          "rollback"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "why_existing_owner": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority_impact": {
            "type": "string"
          },
          "rollback": {
            "type": "string"
          }
        }
      }
    },
    "files_or_owners_not_to_change": {
      "type": "array",
      "items": {
        "type": "string"
      }
