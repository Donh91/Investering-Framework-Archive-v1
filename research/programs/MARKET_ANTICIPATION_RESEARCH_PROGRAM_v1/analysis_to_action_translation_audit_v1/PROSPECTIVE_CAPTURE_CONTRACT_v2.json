    "retroactive_fill": false,
    "missing_event_data": "BLOCKED"
  },
  "freeze_rules": [
    "All forecast and action fields must be frozen before outcome observability.",
    "Analysis and operational translation must use the same knowledge timestamp or disclose separate timestamps.",
    "Missing values remain null.",
    "No later weekly report may reconstruct an earlier forecast.",
    "Source spans for prior-week scoring and current-week forecasting must be separately addressable.",
    "BTC permission and alt permission remain separate.",
    "One dependency cluster may count at most once toward material decision divergence."
  ],
  "outcome_attachment_rules": [
    "Outcomes are attached only by existing owner scorers and verified owner datasets.",
    "The Stage 1B extraction must be frozen before expected rows or outcomes are revealed.",
    "Analysis, price translation, action policy, timing and utility remain separate.",
    "No hidden blended score.",
    "Incomplete horizons remain pending.",
    "No action classification without an instantiated preregistered benchmark.",
    "NEUTRAL is forbidden when the benchmark is absent."
  ],
  "review_rules": {
    "promotion_review_valid_rows": 12,
    "interim_review_valid_rows": 6,
    "independent_blind_replication": "REQUIRED",
    "minimum_incremental_value_rows": 1,
    "material_decision_divergence_dependency_adjusted": true
  },
  "authority": {
