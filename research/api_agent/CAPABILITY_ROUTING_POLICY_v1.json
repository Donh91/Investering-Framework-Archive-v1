      "routing_note": "RESERVE_FOR_TASKS_WHERE_AGENTIC_EXECUTION_OR_CAPABILITY_DELTA_MATERIALLY_EXCEEDS_SOL"
    }
  },
  "escalation_policy": {
    "default": "START_AT_LOWEST_RELIABLY_QUALIFIED_TIER",
    "direct_to_sol_when": [
