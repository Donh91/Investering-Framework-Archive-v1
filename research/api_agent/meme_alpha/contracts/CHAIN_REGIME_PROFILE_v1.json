  "principle": "CHAIN_IS_CONTEXT_NOT_DESTINY",
  "authority": {
    "portfolio_execution": false,
    "automatic_trading": false,
    "buy_now_promotion": false,
    "threshold_rewrite": false,
    "canonical_signal_weight_change": false
  },
  "profile_key": [
    "chain",
    "venue_or_launchpad",
    "venue_version",
    "regime_start",
    "regime_end_or_open",
    "quote_asset",
    "migration_or_pool_destination",
    "creator_incentive_regime",
    "fee_regime",
    "distribution_environment"
  ],
