      "typical_candidate_age_at_discovery",
      "typical_market_cap_bands",
      "typical_liquidity_bands",
      "holder_or_entity_growth_shape",
      "dominant_execution_venues",
      "router_and_aggregator_prevalence",
      "common_slippage_and_exit_capacity_pattern"
    ],
    "behavioral_archetypes": [
      "historically_common_success_archetypes",
      "historically_common_failure_archetypes",
      "phoenix_or_cto_prevalence",
      "first_of_chain_or_native_lore_relevance",
      "celebrity_or_creator_attention_relevance",
      "technical_or_product_meme_relevance",
      "community_takeover_relevance"
    ],
    "risk_and_manipulation": [
      "common_bundle_or_sniper_pattern",
      "common_creator_or_funder_obfuscation_pattern",
      "common_wash_or_router_artifacts",
      "common_holder_count_false_positive",
      "common_liquidity_failure_mode",
      "common_copycat_or_identity_collision_mode",
      "common_social_manipulation_mode"
