{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP_CONNECTION_PILOT_RECEIPT_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "provider",
    "provider_contract",
    "stage",
    "status",
    "created_at_utc",
    "official_server_verified",
    "auth_secret_present",
    "auth_secret_persisted",
    "tool_discovery_status",
    "discovered_tool_count",
    "allowed_read_only_tool_count",
    "mcp_call_count",
    "successful_mcp_call_count",
    "failed_mcp_call_count",
    "mutating_tool_called",
    "provenance_complete",
    "research_questions_total",
    "research_questions_answered",
    "unique_value_items",
    "overlap_items",
    "crosscheck_status",
    "repeat_consistency_status",
    "manual_intervention_count",
    "provider_cost_status",
    "production_dependency",
    "canonical_owner_replaced",
    "hard_blockers",
    "authority"
  ],
  "properties": {
    "contract": {"const": "MCP_CONNECTION_PILOT_RECEIPT_v1"},
    "provider": {"type": "string", "minLength": 1},
    "provider_contract": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL"]},
    "created_at_utc": {"type": "string", "minLength": 1},
    "official_server_verified": {"type": "boolean"},
    "auth_secret_present": {"type": "boolean"},
    "auth_secret_persisted": {"type": "boolean"},
    "tool_discovery_status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL", "NOT_RUN"]},
    "discovered_tool_count": {"type": "integer", "minimum": 0},
    "allowed_read_only_tool_count": {"type": "integer", "minimum": 0},
    "mcp_call_count": {"type": "integer", "minimum": 0},
    "successful_mcp_call_count": {"type": "integer", "minimum": 0},
    "failed_mcp_call_count": {"type": "integer", "minimum": 0},
    "mutating_tool_called": {"type": "boolean"},
    "provenance_complete": {"type": "boolean"},
    "research_questions_total": {"type": "integer", "minimum": 0},
    "research_questions_answered": {"type": "integer", "minimum": 0},
    "unique_value_items": {"type": "integer", "minimum": 0},
    "overlap_items": {"type": "integer", "minimum": 0},
    "crosscheck_status": {"enum": ["PASS", "PARTIAL", "FAIL", "NOT_APPLICABLE", "NOT_RUN"]},
    "repeat_consistency_status": {"enum": ["PASS", "PARTIAL", "FAIL", "NOT_APPLICABLE", "NOT_RUN"]},
    "manual_intervention_count": {"type": "integer", "minimum": 0},
    "provider_cost_status": {"enum": ["WITHIN_BUDGET", "UNKNOWN", "OVER_BUDGET", "NO_INCREMENTAL_COST"]},
    "production_dependency": {"type": "boolean"},
    "canonical_owner_replaced": {"type": "boolean"},
    "hard_blockers": {"type": "array", "items": {"type": "string"}},
    "tool_inventory": {"type": "array", "items": {"type": "object"}},
    "allowed_tool_names": {"type": "array", "items": {"type": "string"}},
    "called_tool_names": {"type": "array", "items": {"type": "string"}},
    "openai_estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "research_output_hash": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_state_change", "portfolio_action", "market_rule_change", "canonical_promotion"],
      "properties": {
        "framework_state_change": {"const": false},
        "portfolio_action": {"const": false},
        "market_rule_change": {"const": false},
        "canonical_promotion": {"const": false}
      }
    }
  }
}
