    "rate_limited": "BOUNDED_RETRY_THEN_DEGRADE_PROVIDER_ONLY",
    "provider_unavailable": "DEGRADE_PROVIDER_ONLY",
    "tool_surface_changed": "REQUIRE_REDISCOVERY_BEFORE_EXECUTION",
