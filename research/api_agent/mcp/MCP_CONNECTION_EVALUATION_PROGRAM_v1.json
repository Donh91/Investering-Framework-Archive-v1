    "allowed_verdicts": ["KEEP_RESEARCH_ACTIVE", "KEEP_CROSSCHECK_ONLY", "SHADOW_OBSERVATION", "CANDIDATE_DISCOVERY_ONLY", "DIAGNOSTICS_ONLY", "HOLD", "KILL", "DATA_BLOCKED"]
  },
  "integration_classes": {
    "RESEARCH_ACTIVE": "May be used by research-capable agents as source context with provenance; no market or portfolio authority.",
    "CROSSCHECK_ACTIVE": "May challenge or recover existing data but cannot replace the canonical owner.",
    "SHADOW_OBSERVATION": "May accumulate prospective shadow evidence only; no automatic sensor or rule promotion.",
    "CANDIDATE_DISCOVERY_ACTIVE": "May nominate assets or questions for research; provider signals are not execution evidence.",
    "DIAGNOSTICS_ACTIVE": "May inspect public/read-only provider data and documentation for diagnostics; canonical owner remains unchanged."
  },
  "authority": {
