    {"rank": 3, "provider": "CoinMarketCap", "contract_path": "research/api_agent/mcp/COINMARKETCAP_MCP_CROSSCHECK_v1.json", "role": "MARKET_CROSSCHECK_RECOVERY", "promotion_ceiling": "CROSSCHECK_ACTIVE", "initial_state": "DOCS_VERIFIED_QUEUED"},
    {"rank": 4, "provider": "TheGraph", "contract_path": "research/api_agent/mcp/THEGRAPH_MCP_PROTOCOL_RESEARCH_v1.json", "role": "PROTOCOL_ONCHAIN_RESEARCH", "promotion_ceiling": "RESEARCH_ACTIVE", "initial_state": "DOCS_VERIFIED_QUEUED"},
    {"rank": 5, "provider": "altFINS", "contract_path": "research/api_agent/mcp/ALTFINS_MCP_CANDIDATE_DISCOVERY_v1.json", "role": "TECHNICAL_CANDIDATE_DISCOVERY", "promotion_ceiling": "CANDIDATE_DISCOVERY_ACTIVE", "initial_state": "DOCS_VERIFIED_QUEUED"},
    {"rank": 6, "provider": "Binance", "contract_path": "research/api_agent/mcp/BINANCE_AGENT_NATIVE_RESEARCH_v1.json", "role": "PUBLIC_MARKET_DIAGNOSTICS_RESEARCH", "promotion_ceiling": "DIAGNOSTICS_ACTIVE", "initial_state": "OFFICIAL_AGENT_NATIVE_VERIFIED_MCP_SURFACE_UNVERIFIED"}
  ],
  "stages": ["OFFICIAL_DOCS_VERIFICATION", "AUTHORITY_AND_SECRET_BOUNDARY", "MCP_TOOL_DISCOVERY_NO_EXECUTION", "READ_ONLY_ALLOWLIST_VERIFICATION", "BOUNDED_LIVE_SMOKE", "BOUNDED_RESEARCH_CHALLENGE", "REDUNDANCY_AND_INCREMENTAL_VALUE_REVIEW", "RESEARCH_LAB_RED_TEAM_REVIEW", "SHADOW_OBSERVATION_IF_JUSTIFIED", "KEEP_HOLD_KILL_CLASSIFICATION"],
  "hard_blockers": ["UNOFFICIAL_OR_UNVERIFIED_SERVER", "SECRET_VALUE_PERSISTED_OR_ECHOED", "TRADING_OR_ORDER_EXECUTION_REQUIRED", "FUND_MOVEMENT_REQUIRED", "PORTFOLIO_OR_ACCOUNT_ACCESS_REQUIRED_FOR_PILOT", "MUTATING_TOOL_CALLED", "READ_ONLY_ALLOWLIST_NOT_ENFORCEABLE", "CANONICAL_OWNER_REPLACEMENT_REQUIRED", "PRODUCTION_DEPENDENCY_REQUIRED", "PROVENANCE_NOT_PRESERVABLE", "UNBOUNDED_PROVIDER_COST_OR_PAYMENT"],
