{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CODEX_RESEARCH_CANDIDATE_v1",
  "title": "Codex Research Candidate v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract",
    "candidate_id",
    "submitted_at_utc",
    "status",
    "origin",
    "title",
    "objective",
    "allowed_change_scope",
    "evidence",
    "reproduction",
    "acceptance_tests",
    "authority_boundary",
    "requires_framework_owner_authority",
    "forbidden_changes",
    "requested_priority"
  ],
  "properties": {
    "contract": {"const": "CODEX_RESEARCH_CANDIDATE_v1"},
    "candidate_id": {"type": "string", "pattern": "^codex-research-[A-Za-z0-9._-]+$"},
    "submitted_at_utc": {"type": "string", "format": "date-time"},
    "status": {"const": "SUBMITTED"},
    "origin": {
      "type": "object",
      "required": ["type", "source_paths"],
      "properties": {
        "type": {"enum": ["RESEARCH_THREAD", "DEEP_RESEARCH", "AUDIT", "EXTERNAL_REVIEW", "MANUAL_RESEARCH"]},
        "thread_label": {"type": ["string", "null"]},
        "source_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "title": {"type": "string", "minLength": 4},
    "objective": {"type": "string", "minLength": 8},
    "finding_key": {"type": "string"},
    "primary_target": {"type": ["string", "null"]},
    "allowed_change_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"enum": ["REPO_PATH", "WORKFLOW_RUN", "TEST", "RESEARCH_RECEIPT", "PR", "COMMIT", "OTHER"]},
          "ref": {"type": "string", "minLength": 1},
          "summary": {"type": "string"}
        }
      }
    },
    "reproduction": {"type": "string", "minLength": 4},
    "acceptance_tests": {
      "type": "object",
      "required": ["positive", "negative"],
      "properties": {
        "positive": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "negative": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "authority_boundary": {"const": "CODE_REMEDIATION_ONLY"},
    "requires_framework_owner_authority": {"const": false},
    "forbidden_changes": {
      "type": "array",
      "allOf": [
        {"contains": {"const": "market gates"}},
        {"contains": {"const": "model weights"}},
        {"contains": {"const": "canonical authority"}},
        {"contains": {"const": "portfolio logic"}},
        {"contains": {"const": "API budget"}},
        {"contains": {"const": "new policy semantics"}}
      ]
    },
    "linked_health_signature": {"type": ["string", "null"], "pattern": "^[0-9a-f]{20}$"},
    "requested_priority": {"enum": ["NORMAL", "EXPEDITED"]},
    "post_fix_gate": {"type": "string"}
  }
}
