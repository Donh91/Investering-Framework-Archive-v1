  "round3_firewall": {
    "mode": "PROSPECTIVE_COLLECTION_ONLY",
    "hypothesis_testing": "OFF",
    "outcome_scoring": "OFF",
    "round1_round2": "CLOSED_EVIDENCE",
    "historical_findings_maximum": "FORWARD_TEST",
    "paid_historical_acquisition": "NOT_AUTHORIZED"
  },
  "routes": [
