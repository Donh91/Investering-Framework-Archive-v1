      "private_data_authority": "Donh91/secrets immutable commit and exact receipt/dataset path",
      "forbidden_actions": ["ASSUME_SINGLE_REPO", "SEARCH_CONTROL_PLANE_FOR_PRIVATE_VALUES", "COPY_PRIVATE_VALUES_PUBLIC"]
    },
    {
