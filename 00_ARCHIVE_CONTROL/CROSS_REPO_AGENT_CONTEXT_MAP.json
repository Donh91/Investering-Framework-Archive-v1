    "restricted:exact binding, receipt, manifest and health record"
  ],
  "global_private_data_authority": {
    "repository": "Donh91/secrets",
    "required_binding_fields": [
      "private_repository",
      "private_commit_sha_reachable_from_main",
      "exact_path",
      "bytes",
      "sha256",
      "source_contract_id",
      "timestamps",
      "schema_id_or_version",
      "schema_sha256",
      "row_or_object_count",
      "gap_count",
      "completeness_status",
      "validation_status"
    ]
  },
  "global_forbidden_actions": [
    "COPY_RAW_OR_NORMALIZED_RESTRICTED_PROVIDER_VALUES_TO_CONTROL_PLANE",
    "COMMIT_CREDENTIALS_TO_EITHER_REPOSITORY",
    "TREAT_DONH91_SECRETS_AS_A_CREDENTIAL_REPOSITORY",
    "INFER_PRIVATE_VALUES_WHEN_RESTRICTED_ACCESS_IS_UNAVAILABLE",
    "USE_MOVING_MAIN_OR_LATEST_POINTER_AS_SOLE_PROVENANCE",
    "RUN_ROUND3_HYPOTHESIS_TESTING_BEFORE_ANALYSIS_GATE",
    "RUN_ROUND3_OUTCOME_SCORING",
    "REOPEN_OR_RESCORE_ROUND1_OR_ROUND2",
