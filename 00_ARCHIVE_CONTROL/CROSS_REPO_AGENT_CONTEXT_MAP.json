{
  "contract": "CROSS_REPO_AGENT_CONTEXT_MAP_v1",
  "status": "CANONICAL_MACHINE_ROUTING_AUTHORITY",
  "effective_date": "2026-08-23",
  "control_plane": "Donh91/Investering-Framework-Archive-v1",
  "restricted_data_plane": "Donh91/secrets",
  "credential_plane": "GITHUB_ACTIONS_SECRETS_OR_EXPLICITLY_APPROVED_RUNTIME_SECRET_MANAGER_OR_WORKLOAD_IDENTITY",
  "canonical_public_boundary": "00_ARCHIVE_CONTROL/CROSS_REPO_DATA_BOUNDARY.md",
