    "control:00_ARCHIVE_CONTROL/ARCHIVE_MAP_AND_ROUTING.md",
    "control:00_ARCHIVE_CONTROL/CROSS_REPO_DATA_BOUNDARY.md",
    "control:00_ARCHIVE_CONTROL/CROSS_REPO_AGENT_CONTEXT_MAP.json",
